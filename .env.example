# Switch Gear — local environment. TEST VALUES ONLY. Copy to .env (git-ignored).
# Nothing here is a real secret, key, account or person.

# Postgres (docker compose service `db`)
POSTGRES_USER=switchgear
POSTGRES_PASSWORD=switchgear-test-only
POSTGRES_DB=switchgear
DATABASE_URL=postgresql://switchgear:switchgear-test-only@localhost:5432/switchgear

# Service URLs (inside docker compose these are overridden to service names)
STORE_URL=http://localhost:3000
SIM_URL=http://localhost:4000
# The sim as the customer's browser reaches it (PayMock pay page); differs from SIM_URL in Docker
SIM_PUBLIC_URL=http://localhost:4000
# Fixed sim business clock speed; T-15 adds controls (1 = real time)
SIM_CLOCK_SPEED=1
SIM_PORT=4000
GATEKEEPER_PORT=4100

# Founder login for the admin console (seeded in T-03)
FOUNDER_EMAIL=founder@example.com
FOUNDER_PASSWORD=test-only-founder-password

# Signs order confirmation links (/orders/ORD-1001?t=...)
ORDER_LINK_SECRET=test-only-order-link-secret

# Webhook HMAC secrets, sim -> store (T-08)
PAYMOCK_WEBHOOK_SECRET=test_paymock_secret
PRINTHUB_WEBHOOK_SECRET=test_printhub_secret
SHIPFAST_WEBHOOK_SECRET=test_shipfast_secret

# sg CLI (T-23). Department keys are generated by the seed into .env.local.keys.
SG_API_URL=http://localhost:3000/api/v1
SG_API_KEY=

# Gatekeeper -> Switch (T-24). Leave empty until the Switch agent is registered; Gatekeeper
# then runs health-only. It also needs SG_KEY_FOUNDER: locally it reads .env.local.keys; for
# docker compose, copy that one line into .env.
# SWITCH_URL is the Switch server address; SWITCH_AGENT_ID and SWITCH_AGENT_TOKEN come from
# registering the agent (POST /agents). SWITCH_FOUNDER_ID is the founder's Switch participant id
# (e.g. @switch-slack-...:server): only messages from it can approve or reject.
# SWITCH_FOUNDER_NAME is the founder's Switch name, mentioned on approval requests.
SWITCH_URL=
SWITCH_AGENT_ID=
SWITCH_AGENT_TOKEN=
SWITCH_FOUNDER_ID=
SWITCH_FOUNDER_NAME=
# Optional: room ids, when a room's name doesn't end in its channel name (e.g. SWITCH_ROOM_EVENTS=...)
# Where Gatekeeper keeps its event cursor and Switch connection id
GATEKEEPER_STATE_FILE=.gatekeeper/state.json
